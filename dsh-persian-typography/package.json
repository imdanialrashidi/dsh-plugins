{
  "name": "@local/dsh-persian-typography",
  "version": "1.0.0",
  "private": true,
  "description": "Persian typography for the Web UI: bundled Vazirmatn font, per-paragraph RTL detection, and bidi isolation for mixed Persian/English text.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "OFL.txt",
    "assets/vazirmatn-var.woff2"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
